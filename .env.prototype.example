# Prototype Environment (Pfaffikon) – copy to .env.prototype
# Isolated from the Rome database. Do not commit real credentials.

# ─── Database (prototype Compose uses postgres-prototype) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres-prototype:5432/jugendleiter2026_prototype
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jugendleiter2026_prototype

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=prototype-dev-secret-change-for-server

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Playtest flags (also hardcoded in docker-compose.prototype.yml) ─────────
PLAYTEST_MODE=true
PLAYTEST_RUN_ID=PT-PFAEFFIKON-IM-BERG
SEED_SKIP_FILTER=true

# ─── Frontend (Vite, baked at build time) ────────────────────────────────────
# Local: http://localhost:3001
# Field test: public API URL, then rebuild frontend-prototype
VITE_API_BASE_URL=http://localhost:3001
VITE_MAPTILER_API_KEY=CHANGE_ME_MAPTILER
FRONTEND_ORIGIN=http://localhost:3001
GM_FRONTEND_ORIGIN=http://localhost:5174

# ─── Object storage (optional for prototype) ─────────────────────────────────
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_FORCE_PATH_STYLE=false
S3_BUCKET=jlw2026-prototype-media
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
