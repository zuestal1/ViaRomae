# Production Environment Configuration
# Copy to .env.production on the server. Never commit that file.

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL host must be the Compose service name "postgres". If the
# password contains URL-reserved characters, percent-encode it in DATABASE_URL.
# Keep the decoded password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/jugendleiter2026
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=jugendleiter2026

# ─── Authentication ──────────────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_32_PLUS_CHARACTERS

# ─── Backend API ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ─── Frontend / GM (must rebuild images after changing VITE_*) ───────────────
VITE_API_BASE_URL=https://api.jlw2026.example.com
VITE_MAPTILER_API_KEY=CHANGE_ME_MAPTILER
VITE_GM_CLIENT_URL=https://gm.jlw2026.example.com
FRONTEND_ORIGIN=https://jlw2026.example.com
GM_FRONTEND_ORIGIN=https://gm.jlw2026.example.com
# VITE_S3_BASE_URL=https://jlw2026-media-production.s3.eu-central-1.amazonaws.com

# ─── Object storage: choose exactly "aws" or "minio" ────────────────────────
STORAGE_PROVIDER=aws

# AWS example. All five S3 values are required for both storage variants.
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# Browser-visible endpoint used verbatim when signing URLs (never a Docker hostname).
S3_PUBLIC_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_FORCE_PATH_STYLE=false
S3_BUCKET=jlw2026-media-production
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY

# MinIO alternative: set STORAGE_PROVIDER=minio, replace the S3 values above
# with the following values, and remove/comment these example lines afterward.
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=via-romae-media
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
# S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
# MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
# MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ─── Approved production roster (required) ─────────────────────────────────
ROSTER_FILE=/srv/via-romae-secrets/roster.production.json
ROSTER_SHA256=CHANGE_ME_64_CHARACTER_SHA256
EXPECTED_PLAYER_COUNT=CHANGE_ME
EXPECTED_TEAM_COUNT=CHANGE_ME

# Optional Nginx domain notes (not read by the app)
# DOMAIN_FRONTEND=jlw2026.example.com
# DOMAIN_API=api.jlw2026.example.com
# DOMAIN_GM=gm.jlw2026.example.com
