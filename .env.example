# Copy to .env for local development. Never commit real credentials.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jugendleiter2026
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jugendleiter2026

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-at-least-32-characters

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Freigegebener Produktions-Roster (keine Klartextcodes einchecken) ──────
ROSTER_FILE=/secure/path/roster.production.json
ROSTER_SHA256=<sha256-der-freigegebenen-rosterdatei>
EXPECTED_PLAYER_COUNT=13
EXPECTED_TEAM_COUNT=4

# ─── Frontend / GM (Vite, baked at build time) ───────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_MAPTILER_API_KEY=your-maptiler-api-key
# VITE_S3_BASE_URL=https://your-bucket.s3.eu-central-1.amazonaws.com

# ─── Object storage ──────────────────────────────────────────────────────────
# Backend reads S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY, with fallback to the short names.
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=jugendleiter2026-media
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
