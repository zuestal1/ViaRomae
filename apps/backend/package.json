{
  "name": "@jlw/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-test-account.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:dev": "cross-env SEED_SKIP_FILTER=true tsx scripts/seed.ts",
    "seed:prototype": "tsx scripts/seed-prototype-pfaeffikon-fixed.ts",
    "test:epic5": "tsx scripts/test-epic5.ts",
    "test:epic8": "tsx scripts/test-epic8.ts",
    "test:ws": "tsx scripts/test-websocket.ts",
    "test:combat:static": "node --test test/combat-action.static.test.mjs",
    "test:combat:integration": "tsx scripts/test-combat-action-replacement.ts"
    ,"test": "tsx --test test/*.test.ts && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "@jlw/contracts": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "ws": "^8.18.0"
  }
}
